# Copy to abyssal/.env before `docker compose up`. Every service reads this file.

# Admin key for Abyssal crawl routes (api-key header) and all Prism routes
# (x-api-key header). The Prism dashboard bundle is built with it, so anyone
# who can load /dashboard/ can read it. Change it for any real deployment.
API_KEY=dev-key-12345

# i2pd runs with network_mode: host, so containers reach it on the bridge gateway
I2PD_HTTP_PROXY=http://172.18.0.1:4444
I2PD_API_URL=https://172.18.0.1:7650
I2PD_PASSWORD=itoopie
WEBCONSOLE_URL=http://172.18.0.1:7070

# Background crawlers (set to false to serve existing data only)
AUTOSEED_ENABLED=true
SCHEDULER_ENABLED=true
REGISTRY_CRAWLER_ENABLED=true
